<UserControl x:Class="USB_FTDI.View.DataShow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:local="clr-namespace:USB_FTDI.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             >

    <UserControl.Resources>
        <!-- Стиль для переключателя -->
        <Style x:Key="SwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <!-- Задний фон -->
                            <Border x:Name="SwitchBorder"
                                    CornerRadius="10"
                                    Background="LightGray"
                                    BorderBrush="DarkGray"
                                    BorderThickness="1"/>
                            <!-- Бегунок -->
                            <Ellipse x:Name="SwitchThumb"
                                     Fill="White"
                                     Width="18" Height="18"
                                     Margin="1"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     RenderTransformOrigin="0.5,0.5"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Активное состояние -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchBorder" Property="Background" Value="#003366"/>
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <!-- Наведение мыши -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchBorder" Property="BorderBrush" Value="Black"/>
                            </Trigger>
                            <!-- Отключенный -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SwitchBorder" Property="Background" Value="#E0E0E0"/>
                                <Setter TargetName="SwitchThumb" Property="Fill" Value="#B0B0B0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        

    </UserControl.Resources>

    <Grid x:Name="MainGrid" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Grid.Row="0"/>
        <StackPanel Grid.Column="0" Grid.Row="1"/>
        <StackPanel Grid.Column="1" Grid.Row="0"/>
        <UniformGrid x:Name="Parents" Columns="4" Grid.Column="2" Grid.Row="1" >
            <ScottPlot:WpfPlot x:Name="MyPlot1"  Background="Yellow"/>
            <ScottPlot:WpfPlot x:Name="MyPlot2" />
            <ScottPlot:WpfPlot x:Name="MyPlot3" />
            <ScottPlot:WpfPlot x:Name="MyPlot4" />
        </UniformGrid>

        <!--<Grid Grid.Column="3" Grid.Row="1">
            <StackPanel Orientation="Vertical">
                
            </StackPanel>
        </Grid>-->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Фильтры -->
            <Border Grid.Row="0" CornerRadius="8" BorderThickness="1" BorderBrush="#DDD" Padding="10" Margin="10">
                <StackPanel>
                    <StackPanel.Background>
                        <SolidColorBrush Color="MintCream"/>
                    </StackPanel.Background>

                    <TextBlock FontSize="16" Text="Фильтрация" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,20"/>

                    <TextBlock FontSize="16" Text="ВЧ фильтр" Margin="0,0,10,0"/>
                    <ToggleButton Style="{StaticResource SwitchStyle}"/>

                    <TextBlock FontSize="16" Text="Режектор 50 Гц" Margin="0,10,10,0"/>
                    <ToggleButton Style="{StaticResource SwitchStyle}" IsChecked="True"/>

                    <TextBlock FontSize="16" Text="НЧ фильтр" Margin="0,10,10,0"/>
                    <ToggleButton Style="{StaticResource SwitchStyle}" IsEnabled="False"/>
                </StackPanel>
            </Border>

            <!-- Кнопки -->
            <StackPanel Grid.Row="1" Orientation="Vertical" Margin="10">
                <Image Source="../image/2.jpg" Width="100" Height="100"/>
                <Button x:Name="OpenFile" Height="40" Content="Открыть" Margin="0,10,0,0" Click="OpenFile_Click"/>
                <Button Height="40" Content="Прикрепить" Margin="0,10,0,0" />
                <Button Height="40" Content="Визуализация" Margin="0,10,0,0" />
                <Button x:Name="Back" Height="40" Content="Назад" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
