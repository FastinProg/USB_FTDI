<UserControl
    x:Class="USB_FTDI.View.NewTwin"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:USB_FTDI.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Width="800" Height="450">
        <Border
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="1"
            Margin="50,0,0,50"
            Padding="20"
            Background="White"
            BorderBrush="#CCCCCC"
            BorderThickness="1"
            CornerRadius="10">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,10"
                    FontSize="18"
                    FontWeight="Bold"
                    Text="Цифровой двойник сердца" />
                <TextBlock
                    Margin="0,0,0,15"
                    FontSize="14"
                    Text="Карточка пациента (по умолчанию)" />
                <TextBlock
                    Margin="0,0,0,5"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="{Binding Name}" />
                <TextBlock>
                    <Run Text="Возраст: " />
                    <Run Text="27" />
                </TextBlock>
                <TextBlock>
                    <Run Text="Пол: " />
                    <Run Text="Мужской" />
                </TextBlock>
                <TextBlock>
                    <Run Text="Дата создания: " />
                    <Run Text="01.09.2025" />
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
