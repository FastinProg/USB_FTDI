<Window x:Class="USB_FTDI.View.WindowVisualization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:USB_FTDI.View"
        mc:Ignorable="d"
        Title="WindowVisualization" Height="650" Width="800">
    <Window.Resources>
        <!-- Стили под светлую тему -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="Background" Value="#FAFAFA"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#222"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,0,8"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,4,0,8"/>
        </Style>

        <!-- Цвета -->
        <SolidColorBrush x:Key="PanelBorder" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="PanelBg" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="PlotBg" Color="White"/>
        <SolidColorBrush x:Key="GridLine" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="AxisLine" Color="#888"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <!-- Левая панель -->
            <ColumnDefinition Width="*"/>
            <!-- Правая часть -->
        </Grid.ColumnDefinitions>

        <!-- Левая панель -->
        <Border Grid.Column="0" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,1,0" Background="{StaticResource PanelBg}">
            <ScrollViewer Padding="16">
                <StackPanel>
                    <TextBlock Text="Данный осмотр" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>

                    <GroupBox Header="Опции">
                        <StackPanel>
                            <ComboBox>
                                <ComboBoxItem Content="Первый раз" IsSelected="True"/>
                                <ComboBoxItem Content="Повторный"/>
                            </ComboBox>
                            <!--<Button Content="Выбрать папку"/>-->
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Параметры торса пациента">
                        <Grid Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Ширина торса, мм" Grid.Row="0" Grid.Column="0"/>
                            <TextBox Text="350" Grid.Row="0" Grid.Column="1"/>

                            <TextBlock Text="Толщина торса, мм" Grid.Row="1" Grid.Column="0"/>
                            <TextBox Text="220" Grid.Row="1" Grid.Column="1"/>

                            <TextBlock Text="Высота торса, мм" Grid.Row="2" Grid.Column="0"/>
                            <TextBox Text="240" Grid.Row="2" Grid.Column="1"/>

                            <TextBlock Text="Шаг по времени, мс" Grid.Row="3" Grid.Column="0"/>
                            <TextBox Text="2" Grid.Row="3" Grid.Column="1"/>

                            <TextBlock Text="Коэффициент Sb" Grid.Row="4" Grid.Column="0"/>
                            <TextBox Text="0.9" Grid.Row="4" Grid.Column="1"/>

                            <TextBlock Text="Номер электрода" Grid.Row="5" Grid.Column="0"/>
                            <TextBox Text="42" Grid.Row="5" Grid.Column="1"/>
                        </Grid>
                    </GroupBox>

                    <Button Content="Запустить" Click="RunButton_Click"/>

                    <!--<GroupBox Header="Сдвиг ЦС">
                        <StackPanel>
                            <TextBlock Text="Сдвиг от спины к груди, мм: 25.06"/>
                            <TextBlock Text="Сдвиг справа налево (°): 6.587"/>
                            <TextBlock Text="Сдвиг вверх-вниз, мм: 3.964"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Вид визуализации">
                        <ComboBox x:Name="ViewMode" SelectedIndex="0">
                            <ComboBoxItem Content="Точка" />
                        </ComboBox>
                    </GroupBox>-->

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!--<TextBlock Text="Кадров в секунду:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Width="72" SelectedIndex="2">
                            <ComboBoxItem Content="10"/>
                            <ComboBoxItem Content="20"/>
                            <ComboBoxItem Content="30"/>
                            <ComboBoxItem Content="60"/>
                        </ComboBox>-->
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Правая часть -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель -->
            <Border Grid.Row="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="False" Margin="12,0">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="#22C55E" Margin="0,0,8,0"/>
                        <!--<TextBlock Text="Auto run" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <ToggleButton x:Name="AutoRunToggle" Margin="6,0,0,0" Width="48" Height="24"/>
                        <TextBlock Text="Auto scale" Margin="16,0,0,0" VerticalAlignment="Center"/>
                        <ToggleButton x:Name="AutoScaleToggle" Margin="6,0,0,0" Width="48" Height="24"/>-->
                    </StackPanel>
                    <!--<TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Opacity="0.6"
                               Text="Демо-режим · 1 точка" />-->
                </DockPanel>
            </Border>

            <!-- Область графика -->
            <Border Grid.Row="1" Margin="12" CornerRadius="8" Background="{StaticResource PlotBg}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
                <Grid>
                    <Canvas x:Name="GridCanvas"/>
                    <Canvas x:Name="AxisCanvas" IsHitTestVisible="False"/>
                    <Canvas x:Name="PlotCanvas" Background="Transparent">
                        <Ellipse x:Name="PointEl" Width="10" Height="10" Fill="#F43F5E" Stroke="Black" StrokeThickness="1"/>
                    </Canvas>
                </Grid>
            </Border>

            <!-- Нижняя панель -->
            <Border Grid.Row="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="t, мс" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider x:Name="SliderX" Grid.Column="1" Minimum="0" Maximum="1000" Value="220" ValueChanged="Slider_ValueChanged"/>

                    <TextBlock Grid.Column="2" Text="A, мВ" VerticalAlignment="Center" Margin="16,0,8,0"/>
                    <Slider x:Name="SliderY" Grid.Column="3" Minimum="-2" Maximum="2" Value="0.6" TickFrequency="0.1" ValueChanged="Slider_ValueChanged"/>

                    <Button Grid.Column="4" Content="Сброс" Click="ResetButton_Click" Margin="16,0,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>