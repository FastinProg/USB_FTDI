<Window
    x:Class="USB_FTDI.View.WindowVisualization"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:USB_FTDI.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="WindowVisualization"
    Width="800"
    Height="650"
    mc:Ignorable="d">
    <Window.Resources>
        <!--  Стили под светлую тему  -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Foreground" Value="#222" />
            <Setter Property="BorderBrush" Value="#CCCCCC" />
            <Setter Property="Background" Value="#FAFAFA" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#222" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,0,8" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="#3B82F6" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#3B82F6" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,4,0,8" />
        </Style>

        <!--  Цвета  -->
        <SolidColorBrush x:Key="PanelBorder" Color="#CCCCCC" />
        <SolidColorBrush x:Key="PanelBg" Color="#FAFAFA" />
        <SolidColorBrush x:Key="PlotBg" Color="White" />
        <SolidColorBrush x:Key="GridLine" Color="#E0E0E0" />
        <SolidColorBrush x:Key="AxisLine" Color="#888" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <!--  Левая панель  -->
            <ColumnDefinition Width="*" />
            <!--  Правая часть  -->
        </Grid.ColumnDefinitions>

        <!--  Левая панель  -->
        <Border
            Grid.Column="0"
            Background="{StaticResource PanelBg}"
            BorderBrush="{StaticResource PanelBorder}"
            BorderThickness="0,0,1,0">
            <ScrollViewer Padding="16">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="16"
                        FontWeight="Bold"
                        Text="Данный осмотр" />

                    <GroupBox Header="Опции">
                        <StackPanel>
                            <ComboBox>
                                <ComboBoxItem Content="Первый раз" IsSelected="True" />
                                <ComboBoxItem Content="Повторный" />
                            </ComboBox>
                            <!--<Button Content="Выбрать папку"/>-->
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Параметры торса пациента">
                        <Grid Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="Ширина торса, мм" />
                            <TextBox
                                Grid.Row="0"
                                Grid.Column="1"
                                Text="350" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Text="Толщина торса, мм" />
                            <TextBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="220" />

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Text="Высота торса, мм" />
                            <TextBox
                                Grid.Row="2"
                                Grid.Column="1"
                                Text="240" />

                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="0"
                                Text="Шаг по времени, мс" />
                            <TextBox
                                Grid.Row="3"
                                Grid.Column="1"
                                Text="2" />

                            <TextBlock
                                Grid.Row="4"
                                Grid.Column="0"
                                Text="Коэффициент Sb" />
                            <TextBox
                                Grid.Row="4"
                                Grid.Column="1"
                                Text="0.9" />

                            <TextBlock
                                Grid.Row="5"
                                Grid.Column="0"
                                Text="Номер электрода" />
                            <TextBox
                                Grid.Row="5"
                                Grid.Column="1"
                                Text="42" />
                        </Grid>
                    </GroupBox>

                    <Button Click="RunButton_Click" Content="Запустить" />
                    <Button Click="RunButton_Click" Content="Назад" />

                    <!--<GroupBox Header="Сдвиг ЦС">
                        <StackPanel>
                            <TextBlock Text="Сдвиг от спины к груди, мм: 25.06"/>
                            <TextBlock Text="Сдвиг справа налево (°): 6.587"/>
                            <TextBlock Text="Сдвиг вверх-вниз, мм: 3.964"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Вид визуализации">
                        <ComboBox x:Name="ViewMode" SelectedIndex="0">
                            <ComboBoxItem Content="Точка" />
                        </ComboBox>
                    </GroupBox>-->

                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <!--<TextBlock Text="Кадров в секунду:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Width="72" SelectedIndex="2">
                            <ComboBoxItem Content="10"/>
                            <ComboBoxItem Content="20"/>
                            <ComboBoxItem Content="30"/>
                            <ComboBoxItem Content="60"/>
                        </ComboBox>-->
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--  Правая часть  -->
        <!--  Правая часть  -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="64" />
            </Grid.RowDefinitions>

            <!--  Верхняя панель  -->
            <Border
                Grid.Row="0"
                Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="0,0,0,1">
                <DockPanel Margin="12,0" LastChildFill="False">
                    <StackPanel
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                        Orientation="Horizontal">
                        <Ellipse
                            Width="10"
                            Height="10"
                            Margin="0,0,8,0"
                            Fill="#22C55E" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!--  Области графиков  -->
            <Grid Grid.Row="1" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" />
                    <!--  верхний график (ЭКГ)  -->
                    <RowDefinition Height="2*" />
                    <!--  нижний график (визуализация)  -->
                </Grid.RowDefinitions>

                <!--  Верхний график с осями  -->
                <Border
                    Grid.Row="0"
                    Margin="0,0,0,8"
                    Background="{StaticResource PlotBg}"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Canvas x:Name="GridCanvas" />
                        <Canvas x:Name="AxisCanvas" IsHitTestVisible="False" />
                        <Canvas x:Name="PlotCanvas" Background="Transparent">
                            <Ellipse
                                x:Name="PointEl"
                                Width="10"
                                Height="10"
                                Fill="#F43F5E"
                                Stroke="Black"
                                StrokeThickness="1" />
                        </Canvas>
                    </Grid>
                </Border>

                <!--  Нижний график (пустой, под визуализацию)  -->
                <Border
                    Grid.Row="1"
                    Background="#FAFAFA"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Canvas x:Name="VisualizationCanvas" Background="Transparent" />
                    </Grid>
                </Border>
            </Grid>

            <!--  Нижняя панель  -->
            <Border
                Grid.Row="2"
                Padding="12"
                Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Text="t, мс" />
                    <Slider
                        x:Name="SliderX"
                        Grid.Column="1"
                        Maximum="1000"
                        Minimum="0"
                        ValueChanged="Slider_ValueChanged"
                        Value="220" />

                    <TextBlock
                        Grid.Column="2"
                        Margin="16,0,8,0"
                        VerticalAlignment="Center"
                        Text="A, мВ" />
                    <Slider
                        x:Name="SliderY"
                        Grid.Column="3"
                        Maximum="2"
                        Minimum="-2"
                        TickFrequency="0.1"
                        ValueChanged="Slider_ValueChanged"
                        Value="0.6" />

                    <Button
                        Grid.Column="4"
                        Margin="16,0,0,0"
                        Click="ResetButton_Click"
                        Content="Сброс" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>