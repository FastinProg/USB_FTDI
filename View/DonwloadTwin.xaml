<Window
    x:Class="USB_FTDI.View.DonwloadTwin"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:USB_FTDI.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="ССНЭКД"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4A90E2" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Height" Value="50" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="BorderBrush" Value="#357ABD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!--  Наведение  -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#357ABD" />
                            </Trigger>
                            <!--  Нажатие  -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2C5F9C" />
                            </Trigger>
                            <!--  Кнопка выбрана  -->
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="border" Property="Background" Value="#f52bff" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                            <!--  Отключена  -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="Gray" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--  Корневой Grid растягивается на весь экран  -->
    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="300" />
            <RowDefinition Height="*" />
            <RowDefinition Height="80" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="500" />
            <ColumnDefinition Width="50" />
        </Grid.ColumnDefinitions>

        <!--  Левое меню  -->
        <StackPanel
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="0"
            Width="150"
            Background="#FFEEF4FF"
            Orientation="Vertical">
            <Button
                x:Name="ButtonNewTwin"
                Click="ButtonNewTwin_Click"
                Style="{StaticResource MenuButtonStyle}">
                <TextBlock
                    Text="Создать анкету пациента"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </Button>
            <Button
                x:Name="ButtonDonload"
                Click="ButtonNewTwin_Click"
                Cursor="Hand"
                Style="{StaticResource MenuButtonStyle}">
                <TextBlock
                    Text="Загрузить двойника"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </Button>
            <Button x:Name="ButtonSee" Style="{StaticResource MenuButtonStyle}">
                <TextBlock
                    Cursor=""
                    Text="Просмотр двойника"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </Button>
            <Button x:Name="Start_reg" Style="{StaticResource MenuButtonStyle}">
                <TextBlock
                    Cursor=""
                    Text="Начать регистрацию"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </Button>
            <Button
                x:Name="Back"
                Cursor="Hand"
                Style="{StaticResource MenuButtonStyle}">
                <TextBlock
                    Text="Назад"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </Button>
            <Button x:Name="ButtonTermianl" Visibility="Hidden">
                <TextBlock
                    Text="Терминал"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </Button>
            <Button x:Name="ButtonParsing" Visibility="Hidden">
                <TextBlock
                    Text="Визуализация"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </Button>
        </StackPanel>
        <!--  Правое меню  -->
        <Grid
            Grid.RowSpan="3"
            Grid.Column="1"
            Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>


            <!--  Заголовок  -->
            <TextBlock
                Grid.Row="0"
                FontSize="20"
                FontWeight="Bold"
                Text="Цифровой двойник сердца" />

            <!--  Имя пациента  -->
            <StackPanel Grid.Row="2">
                <TextBlock
                    Margin="0,0,0,5"
                    FontSize="16"
                    Text="ФИО пациента" />
                <TextBox
                    x:Name="TextBoxName"
                    Height="30"
                    FontSize="14" />
            </StackPanel>

            <!--  Возраст  -->
            <StackPanel Grid.Row="4">
                <TextBlock
                    Margin="0,0,0,5"
                    FontSize="16"
                    Text="Возраст" />
                <StackPanel Orientation="Horizontal">
                    <TextBox
                        x:Name="TextBoxAge"
                        Width="50"
                        Height="30"
                        Text="" />

                </StackPanel>
            </StackPanel>

            <!--  Пол  -->
            <StackPanel Grid.Row="6">
                <TextBlock
                    Margin="0,0,0,5"
                    FontSize="16"
                    Text="Пол" />
                <ComboBox x:Name="ComboBoxGender" Height="30">
                    <ComboBoxItem Content="Мужской" />
                    <ComboBoxItem Content="Женский" />
                </ComboBox>
                <DatePicker Margin="0,10,0,0" FontSize="16" />
            </StackPanel>

            <!--  Кнопка Создать  -->
            <Button
                Grid.Row="8"
                Width="100"
                Height="35"
                HorizontalAlignment="Left"
                Click="Button_Click"
                Content="Выбрать"
                Style="{StaticResource MenuButtonStyle}" />

        </Grid>
    </Grid>
</Window>